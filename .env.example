# Copy to .env and fill in. Never commit .env.

# Postgres. Free at neon.com — use the POOLED connection string, the one whose
# host contains "-pooler". Looks like:
#   postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Public origin this app is reachable at. Used to build board URLs, webhook
# URLs and the OAuth redirect. Never derived from the Host header.
PUBLIC_BASE_URL=http://localhost:3000

# 32 random bytes, base64. Encrypts bot tokens at rest:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=

# Google sign-in (phase 3). console.cloud.google.com, OAuth client type "Web".
# Authorized redirect URIs must include:
#   http://localhost:3000/auth/google/callback
#   https://<your-render-host>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Support form delivery (phase 6). postmarkapp.com server token.
POSTMARK_TOKEN=
POSTMARK_FROM=
SUPPORT_TO=
