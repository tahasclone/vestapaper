{
  "name": "solaris-wallpaper",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,vite -c yellow,cyan \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite\"",
    "build": "tsc -b && vite build",
    "start": "npm run build && tsx server/index.ts",
    "serve": "tsx --env-file-if-exists=.env server/index.ts",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate-cli.ts",
    "import-config": "tsx --env-file-if-exists=.env scripts/import-local-config.ts"
  },
  "dependencies": {
    "express": "^4.21.0",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.4",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
